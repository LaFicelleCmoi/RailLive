# Copier ce fichier en server/.env puis renseigner la clé.
# Ce fichier .env ne doit JAMAIS être commité ni copié côté client.

# Clé API SNCF (https://numerique.sncf.com/startup/api/token-developpeur/)
SNCF_API_KEY=

# Optionnel
SNCF_API_BASE_URL=https://api.sncf.com/v1
PORT=3001
# Origines autorisées (CORS), séparées par des virgules
ALLOWED_ORIGIN=http://localhost:5173
# Nombre d'appels à l'API SNCF autorisés par jour avant blocage côté proxy
DAILY_QUOTA=5000
# Requêtes par minute et par IP sur /api/sncf
RATE_LIMIT_PER_MINUTE=120
# Nombre de reverse proxies devant le serveur (0 en local, 1 derrière Nginx/Render/etc.)
TRUST_PROXY=0
