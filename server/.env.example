# Copier ce fichier en server/.env puis renseigner le token.
# Ce fichier .env ne doit JAMAIS être commité ni copié côté client.

# Token Navitia (https://navitia.io → compte → clé d'authentification)
NAVITIA_TOKEN=

# Optionnel
NAVITIA_BASE_URL=https://api.navitia.io/v1
NAVITIA_COVERAGE=sncf
PORT=3001
# Origines autorisées (CORS), séparées par des virgules
ALLOWED_ORIGIN=http://localhost:5173
# Nombre d'appels amont autorisés par jour avant blocage côté proxy
DAILY_QUOTA=3000
# Requêtes par minute et par IP sur /api/navitia
RATE_LIMIT_PER_MINUTE=120
# Nombre de reverse proxies devant le serveur (0 en local, 1 derrière Nginx/Render/etc.)
TRUST_PROXY=0
